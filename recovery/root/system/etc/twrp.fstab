# Logical partitions (Super)
/system          ext4      system                                     flags=display="System";logical;slotselect
/system_dlkm     ext4      system_dlkm                                flags=display="System DLKM";logical;slotselect
/vendor          ext4      vendor                                     flags=display="Vendor";logical;slotselect
/vendor_dlkm     erofs     vendor_dlkm                                flags=display="Vendor DLKM";logical;slotselect
/product         erofs     product                                    flags=display="Product";logical;slotselect

# Dynamic partitions (Backup / Flash Image)
/system_image    emmc      /dev/block/mapper/system                   flags=display="System Image";slotselect;backup=1;flashimg=1
/vendor_image    emmc      /dev/block/mapper/vendor                   flags=display="Vendor Image";slotselect;backup=1;flashimg=1
/product_image   emmc      /dev/block/mapper/product                  flags=display="Product Image";slotselect;backup=1;flashimg=1

# Physical partitions
/data            f2fs      /dev/block/by-name/userdata                flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/metadata        emmc      /dev/block/by-name/metadata                flags=display="Metadata";backup=1
/boot            emmc      /dev/block/by-name/boot                    flags=display="Boot";slotselect;backup=1;flashimg=1
/vendor_boot     emmc      /dev/block/by-name/vendor_boot             flags=display="Vendor Boot";slotselect;backup=1;flashimg=1
/misc            emmc      /dev/block/by-name/misc                    flags=display="Misc";backup=1
/super           emmc      /dev/block/by-name/super                   flags=display="Super";backup=1;flashimg=1
/persistent      emmc      /dev/block/by-name/frp                     flags=display="FRP";backup=1
/treadahead      emmc      /dev/block/by-name/treadahead              flags=display="Treadahead";backup=1
/oem             emmc      /dev/block/by-name/media_data              flags=display="OEM";backup=1
/Reserve0        emmc      /dev/block/by-name/Reserve0                flags=display="Reserve0";backup=1

# Removable Storage
/external_sd     auto      /dev/block/mmcblk0p1  /dev/block/mmcblk0   flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb-otg         auto      /dev/block/sda1       /dev/block/sda       flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"
