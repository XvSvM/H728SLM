# Android fstab file - fixed for H728 / sun55iw3p1
#<src>                                                 <mnt_point>  <type>   <mnt_flags and options>      <fs_mgr_flags>

# Dynamic partitions (logical + slotselect)
system                                                 /system      erofs     ro                 wait,first_stage_mount,logical,slotselect
system                                                 /system      ext4      ro,barrier=1       wait,first_stage_mount,logical,slotselect
system_dlkm                                            /system_dlkm ext4      ro                 wait,first_stage_mount,logical,slotselect
vendor                                                 /vendor      erofs     ro                 wait,first_stage_mount,logical,slotselect
vendor_dlkm                                            /vendor_dlkm erofs     ro                 wait,first_stage_mount,logical,slotselect
product                                                /product     erofs     ro                 wait,first_stage_mount,logical,slotselect

# Data & metadata
/dev/block/by-name/userdata                            /data        f2fs     noatime,nosuid,nodev,fastboot,discard,reserve_root=128000,resuid=0,resgid=1065 wait,check,formattable,quota,reservedsize=128M,latemount,checkpoint=fs
/dev/block/by-name/metadata                            /metadata    ext4     nodev,noatime,nosuid,errors=panic wait,first_stage_mount,formattable,check
/dev/block/by-name/treadahead                          /treadahead  ext4     nodev,noatime,nosuid,errors=panic wait,first_stage_mount,formattable,check
/dev/block/by-name/media_data                          /oem         vfat     ro,nodev,noatime,nosuid,context=u:object_r:oemfs:s0 wait,first_stage_mount,formattable,check

# A/B partitions slotselect
/dev/block/by-name/boot                                /boot        emmc     defaults                     defaults
/dev/block/by-name/init_boot                           /init_boot   emmc     defaults                     defaults
/dev/block/by-name/vendor_boot                         /vendor_boot emmc     defaults                     defaults
/dev/block/by-name/dtbo                                /dtbo        emmc     defaults                     defaults
/dev/block/by-name/vbmeta                              /vbmeta      emmc     defaults                     defaults
/dev/block/by-name/vbmeta_system                       /vbmeta_system emmc   defaults                     defaults
/dev/block/by-name/vbmeta_vendor                       /vbmeta_vendor emmc   defaults                     defaults
/dev/block/by-name/bootloader                          /bootloader  emmc     defaults                     defaults

# Other
/dev/block/by-name/misc                                /misc        emmc     defaults                     defaults
/dev/block/by-name/super                               /super       emmc     defaults                     defaults
/dev/block/by-name/frp                                 /persistent  emmc     defaults                     defaults
/dev/block/by-name/Reserve0                            /Reserve0    vfat     nodev,noatime,nosuid         wait,first_stage_mount,formattable,check

# External storage
/devices/platform/*/4020000.sdmmc/mmc_host/mmc*        auto         auto     defaults                     voldmanaged=extsd:auto,encryptable=footer
/devices/platform/**/usb*                              auto         auto     defaults                     voldmanaged=usb:auto,encryptable=footer

# Recovery only
none                                                   /sdcard      emmc     defaults                     defaults,recoveryonly
