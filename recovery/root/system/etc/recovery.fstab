
# X96Q Pro+ - Allwinner H728

# Dynamic partitions
/system          erofs     system                  flags=display=system;logical;slotselect
/system          ext4      system                  flags=display=system;logical;slotselect
/system_dlkm     ext4      system_dlkm             flags=display=system_dlkm;logical;slotselect
/vendor          erofs     vendor                  flags=display=vendor;logical;slotselect
/vendor_dlkm     erofs     vendor_dlkm             flags=display=vendor_dlkm;logical;slotselect
/product         erofs     product                 flags=display=product;logical;slotselect

# User data
/data            f2fs      /dev/block/by-name/userdata flags=display=data
/metadata        ext4      /dev/block/by-name/metadata flags=display=metadata
/treadahead      ext4      /dev/block/by-name/treadahead flags=display=treadahead

# OEM
/oem             vfat      /dev/block/by-name/media_data flags=display=oem
/Reserve0        vfat      /dev/block/by-name/Reserve0 flags=display=Reserve0

# Boot partitions (A/B)
/boot            emmc      /dev/block/by-name/boot       flags=display=boot;slotselect
/vendor_boot     emmc      /dev/block/by-name/vendor_boot flags=display=vendor_boot;slotselect
/init_boot       emmc      /dev/block/by-name/init_boot  flags=display=init_boot;slotselect
/dtbo            emmc      /dev/block/by-name/dtbo       flags=display=dtbo;slotselect

# Other partitions
/misc            emmc      /dev/block/by-name/misc
/super           emmc      /dev/block/by-name/super
/persistent      emmc      /dev/block/by-name/frp

# External storage
auto             auto      /devices/platform/*/4020000.sdmmc/mmc_host/mmc*
auto             auto      /devices/platform/**/usb*
